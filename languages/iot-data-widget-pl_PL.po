#. Plugin Name of the plugin
#: iot-data-widget.php
msgid "IoT Data Widget – Home Assistant, MQTT & Smart Home Sensors"
msgstr "IoT Data Widget – Home Assistant, MQTT i czujniki inteligentnego domu"

#: admin/class-admin-page.php:80
#: admin/class-admin-page.php:81
msgid "IoT Data Widget"
msgstr "IoT Data Widget"

#. Description of the plugin
#: iot-data-widget.php
msgid "Displays live data from smart home devices (Home Assistant, REST API, MQTT, Shelly/Tasmota/ESPHome presets, Shelly Cloud) on your website via shortcode and Gutenberg block, with a guided setup wizard, a redesigned and auto-refreshing appearance, and a built-in diagnostics page. Pro adds threshold alerts, email reports, and a public embed mode."
msgstr "Wyświetla dane na żywo z urządzeń smart home (Home Assistant, REST API, MQTT, presety Shelly/Tasmota/ESPHome, Shelly Cloud) w witrynie za pomocą shortcode'u i bloku Gutenberga. Zawiera kreator konfiguracji, nowy wygląd z automatycznym odświeżaniem i wbudowaną stronę diagnostyki. Wersja Pro dodaje alerty progowe, raporty e-mail i tryb publicznego osadzania."

#. Author of the plugin
#: iot-data-widget.php
msgid "WPVeloxa"
msgstr "WPVeloxa"

